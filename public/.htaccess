# Public docroot. Everything outside /public (src, config, lang, views, db)
# must stay unreachable over HTTP — the vhost points DocumentRoot here.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Serve real files/dirs as-is; no front controller yet.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Never serve dotfiles or backups.
<FilesMatch "^\.|\.(sql|ini|log|bak|sample)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
